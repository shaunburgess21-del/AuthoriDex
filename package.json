{
  "name": "rest-express",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "cross-env NODE_ENV=development tsx --env-file=.env server/index.ts",
    "build": "npm run check && vite build && esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "build:client": "vite build",
    "start": "node scripts/db-deploy-migrate.cjs && cross-env NODE_ENV=production node dist/index.js",
    "db:deploy-migrate": "node scripts/db-deploy-migrate.cjs",
    "check": "tsc",
    "test": "tsx --test tests/*.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:baseline": "tsx --env-file=.env scripts/db-baseline.cjs",
    "db:push": "tsx --env-file=.env scripts/db-push-safe.cjs",
    "db:push:raw": "drizzle-kit push",
    "import:induction": "tsx --env-file=.env server/scripts/import-induction-csv.ts",
    "backfill:handles": "tsx --env-file=.env server/scripts/backfill-social-handles.ts",
    "audit:handles": "tsx --env-file=.env server/scripts/audit-social-handles.ts",
    "apply:handle-verdicts": "tsx --env-file=.env server/scripts/apply-handle-verdicts.ts",
    "db:ensure-induction-cols": "tsx --env-file=.env server/scripts/ensure-induction-candidate-columns.ts",
    "db:ensure": "tsx --env-file=.env server/scripts/run-ensure-schema.ts",
    "eval:profiles": "tsx --env-file=.env server/scripts/evaluate-profile-models.ts",
    "validate:induction-post-import": "tsx --env-file=.env server/scripts/validate-induction-post-import.ts"
  },
