# ─────────────────────────────────────────────────────────────────────────────
# VoxDex / AuthoriDex — Environment variable reference
#
# Copy this to `.env` and fill in values for local dev. In production (Railway,
# Vercel, etc.) set these in the platform's env/secrets UI. Anything marked
# REQUIRED must be present for the server to boot cleanly.
#
# Sections:
#   1.  Core runtime
#   2.  Database (Postgres / Supabase)
#   3.  Auth (Supabase)
#   4.  External APIs (providers)
#   5.  AI / OpenAI
#   6.  Ingestion & scoring engine
#   7.  Rate limiting
#   8.  Schedulers & cron
#   9.  Retention & cleanup
#  10.  Feature flags & misc
#  11.  Dev / scripts only (never set in prod)
# ─────────────────────────────────────────────────────────────────────────────


# ─── 1. Core runtime ────────────────────────────────────────────────────────
# REQUIRED in production. One of: "development" | "production" | "test".
NODE_ENV=development

# Port the Express app listens on. Defaults to 5000.
PORT=5000
HOST=0.0.0.0

# Set to "true" only on platforms like Vercel where in-process schedulers
# should be disabled (cron endpoints take over instead).
SERVERLESS_MODE=false

# When true, `unhandledRejection` forces process.exit(1) even in production.
# Default is false — we log + keep serving. Set to true only if you explicitly
# want crash-loop-on-reject semantics.
STRICT_UNHANDLED_REJECTION=false


# ─── 2. Database (Postgres / Supabase) ──────────────────────────────────────
# REQUIRED. Full Postgres connection string.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Optional CA cert for Postgres SSL (paste PEM contents). When present, the
# pool connects with `ssl: { ca }`. Use together with the strict flag below if
# your provider hands out a private CA.
DATABASE_CA_CERT=

# When "true" the Postgres pool sets `rejectUnauthorized: true`. Defaults to
# `false` (friendly for Supabase/Neon default certs).
DATABASE_SSL_REJECT_UNAUTHORIZED=false

# Max Postgres connections in the pool. Defaults to 10.
DB_POOL_MAX=10

# When "true", the ingest job refuses to run unless DB guardrails (advisory
# lock, heartbeat) are configured. Keep "true" in prod.
REQUIRE_DB_GUARDRAILS=false


# ─── 3. Auth (Supabase) ─────────────────────────────────────────────────────
# REQUIRED. Public Supabase project URL (e.g. https://xxxxx.supabase.co).
SUPABASE_URL=

# REQUIRED on the client (shipped to browser). The anon/publishable key.
SUPABASE_ANON_KEY=

# REQUIRED on the server. Service-role key — NEVER ship to client.
SUPABASE_SERVICE_ROLE_KEY=


# ─── 4. External APIs (providers) ───────────────────────────────────────────
# News volume providers. At least one should be set.
MEDIASTACK_API_KEY=
SERPER_API_KEY=
NEWS_API_KEY=                 # legacy NewsAPI, optional
SERP_API_KEY=                 # legacy SerpAPI, optional
YOUTUBE_API_KEY=              # optional, YouTube stats
SPOTIFY_CLIENT_ID=            # optional
SPOTIFY_CLIENT_SECRET=        # optional
X_API_KEY=                    # optional, X/Twitter
X_API_SECRET=                 # optional

# GDELT TLS escape hatch. Set to "true" only when your host can't validate the
# GDELT cert chain. Ignored in production unless GDELT_RELAX_SSL_FORCE=true.
GDELT_RELAX_SSL=false
GDELT_RELAX_SSL_FORCE=false   # emergency-only prod override (DANGEROUS)


# ─── 5. AI / OpenAI ─────────────────────────────────────────────────────────
# The app prefers AI_INTEGRATIONS_OPENAI_API_KEY and falls back to OPENAI_API_KEY.
AI_INTEGRATIONS_OPENAI_API_KEY=
OPENAI_API_KEY=


# ─── 6. Ingestion & scoring engine ──────────────────────────────────────────
# How often the in-process ingestion scheduler runs (minutes). Default 60.
INGEST_INTERVAL_MINUTES=60

# Per-source news-refresh cadence for Mediastack (minutes). Default 180 (3h).
# At 159 tracked people, 180min ≈ 38k calls/cycle (76% of the 50k/month plan).
# Drop to 120 only after upgrading to a higher plan tier — the budget hard-stop
# will throttle automatically if projected usage approaches the cycle limit.
MEDIASTACK_REFRESH_INTERVAL_MINUTES=180

# Scoring engine is a raw mass/velocity composite — no smoothing, no rate
# limiting, no catch-up mode. Legacy variables (SMOOTHING_MODE, EMA_*,
# SPIKE_MIN_DELTA_*, OUTAGE_WEIGHT_REDIST, SMOOTHING_RELAXED_*) are no longer
# read; they can be safely removed from deployment environments.

# News aggregation mode. One of:
#   tiered — single provider per person (Mediastack → GDELT → Serper fallback)
#   union  — union of all providers with URL-level dedup (more coverage)
NEWS_AGGREGATION_MODE=union

# ISO 8601 timestamp marking when you flipped to `union` mode. Percentile stats
# for the `news_count` source are computed from snapshots AFTER this cutoff, so
# the momentum-signal thresholds don't get dragged down by legacy single-source
# data. Required when NEWS_AGGREGATION_MODE=union.
NEWS_AGGREGATION_FLIPPED_AT=

# When "false", trims the verbose per-person diagnostics JSONB written on every
# snapshot. Default "true" — keep verbose during calibration, flip to "false"
# once thresholds are settled.
DIAGNOSTICS_VERBOSE=true

# Rolling window (days) used to compute percentile stats (p25/p50/p75) from
# snapshots. Shorter window = faster calibration to new levels.
ROLLING_WINDOW_DAYS_BASELINE=14   # wiki + search
ROLLING_WINDOW_DAYS_NEWS=7        # news only (reacts faster to aggregation changes)


# ─── 7. Rate limiting ───────────────────────────────────────────────────────
LEADERBOARD_MAX_LIMIT=500
LEADERBOARD_MAX_OFFSET=20000

API_READ_RATE_LIMIT_MAX=600
API_WRITE_RATE_LIMIT_AUTH_MAX=60
API_WRITE_RATE_LIMIT_ANON_MAX=15
API_AUTH_RATE_LIMIT_MAX=10

# Admin bucket — applied to /api/admin/* only. Much higher ceiling than the
# default write bucket. Default 300 / minute.
API_ADMIN_RATE_LIMIT_MAX=300


# ─── 8. Schedulers & cron ───────────────────────────────────────────────────
# Shared secret for /api/cron/* endpoints (Railway/Vercel cron calls).
# REQUIRED when running behind an external cron trigger.
CRON_SECRET=

# Kill-switch — when "true", NO in-process scheduler starts. Use when running
# exclusively via the /api/cron/* endpoints so you don't double-run.
DISABLE_SCHEDULERS=false


# ─── 9. Retention & cleanup ─────────────────────────────────────────────────
# Number of days of `page_views` to retain. Between 7 and 730, default 180.
PAGE_VIEW_RETENTION_DAYS=180


# ─── 10. Feature flags & misc ───────────────────────────────────────────────
# When "true" (default after 2026-05-01: false), drops the World Market skip
# rate dramatically and 1.5x's the activity gate. This multiplies the per-sweep
# OpenAI call volume ~3x. Only flip back on once you've validated the per-market
# cache is keeping costs in check.
WORLD_MARKET_BOOST_ENABLED=false

# HARD KILL SWITCH for World Market LLM calls (web_search Responses API).
# Default: false. When unset/false, agents abstain from World Markets without
# ever touching OpenAI. Native markets (Jackpot/H2H/UpDown/Gainer) are
# unaffected — they use the deterministic engine and cost nothing.
#
# Set to "true" ONLY when:
#   1. The OpenAI billing balance is healthy, AND
#   2. You're ready for ~$0.25 per uncovered World Market per 24h
#      (the per-market cache amortises the cost across all 56 V2 agents).
#
# Background: on 2026-05-01 a single overnight sweep with this engine
# (uncached) burned $45 in 2 hours. The fix introduces a per-market cache in
# predictionMarkets.metadata.worldAssessment that all agents share. With the
# cache + this kill switch off by default, accidental cost runaway is contained.
WORLD_MARKETS_LLM_ENABLED=false

# Optional Discord webhook for critical alerts (ingest failures, etc.).
DISCORD_WEBHOOK_URL=

# Structured logging / observability (all optional).
LOG_LEVEL=info                # one of: trace | debug | info | warn | error | fatal
LOG_PRETTY=false              # "true" for human-friendly dev output
SENTRY_DSN=                   # when set, server-side errors are reported to Sentry


# ─── 11. Dev / scripts only (NEVER set in prod) ─────────────────────────────
# Gate behind NODE_ENV !== 'production' checks at the code level.
ENABLE_TEST_ENDPOINTS=false
ALLOW_SEED_DELETE=false
CONFIRM_SEED_DELETE=
DRY_RUN=true
SKIP_VALIDATION=false
VERCEL=                       # set automatically on Vercel; forces serverless mode
