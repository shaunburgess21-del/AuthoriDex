# ─────────────────────────────────────────────────────────────────────────────
# VoxDex / AuthoriDex — Environment variable reference
#
# Copy this to `.env` and fill in values for local dev. In production (Railway,
# Vercel, etc.) set these in the platform's env/secrets UI. Anything marked
# REQUIRED must be present for the server to boot cleanly.
#
# Sections:
#   1.  Core runtime
#   2.  Database (Postgres / Supabase)
#   3.  Auth (Supabase)
#   4.  Email (Resend + auth hook)
#   5.  External APIs (providers)
#   6.  AI / OpenAI
#   7.  Ingestion & scoring engine
#   8.  Rate limiting
#   9.  Schedulers & cron
#  10.  Retention & cleanup
#  11.  Feature flags & misc
#  12.  Optional tuning knobs (all have code defaults)
#  13.  Dev / scripts only (never set in prod)
# ─────────────────────────────────────────────────────────────────────────────


# ─── 1. Core runtime ────────────────────────────────────────────────────────
# REQUIRED in production. One of: "development" | "production" | "test".
NODE_ENV=development

# Port the Express app listens on. Defaults to 5000.
PORT=5000
HOST=0.0.0.0

# Canonical public app origin used in transactional/lifecycle links.
# Set this in production so email CTAs never fall back to an internal host.
PUBLIC_APP_URL=https://voxdex.com
# Legacy alias still read by the server for back-compat.
APP_URL=https://voxdex.com
# Origin used by the OG / share-page payload builder (server/services/
# og-page-payload.ts). Defaults to https://voxdex.com when unset.
PUBLIC_SITE_URL=https://voxdex.com

# Set to "true" only on platforms like Vercel where in-process schedulers
# should be disabled (cron endpoints take over instead).
SERVERLESS_MODE=false

# When true, `unhandledRejection` forces process.exit(1) even in production.
# Default is false — we log + keep serving. Set to true only if you explicitly
# want crash-loop-on-reject semantics.
STRICT_UNHANDLED_REJECTION=false


# ─── 2. Database (Postgres / Supabase) ──────────────────────────────────────
# REQUIRED. Full Postgres connection string.
# Supabase: prefer the transaction pooler (port 6543), not session mode (5432).
DATABASE_URL=postgresql://user:password@host:6543/dbname

# Optional CA cert for Postgres SSL (paste PEM contents). When present, the
# pool connects with `ssl: { ca }`. Use together with the strict flag below if
# your provider hands out a private CA.
DATABASE_CA_CERT=

# When "true" the Postgres pool sets `rejectUnauthorized: true`. Defaults to
# `false` (friendly for Supabase/Neon default certs).
DATABASE_SSL_REJECT_UNAUTHORIZED=false

# Max Postgres connections in the pool. Defaults to 25 in code.
DB_POOL_MAX=25

# Per-statement timeout (ms), applied via SET on each connection. Guards against
# runaway queries; keep above the slowest legitimate analytics job (~20s).
# Defaults to 30000 in code. Set 0 to disable.
DB_STATEMENT_TIMEOUT_MS=30000

# When "true", the ingest job refuses to run unless DB guardrails (advisory
# lock, heartbeat) are configured. Keep "true" in prod.
REQUIRE_DB_GUARDRAILS=false


# ─── 3. Auth (Supabase) ─────────────────────────────────────────────────────
# REQUIRED. Public Supabase project URL (e.g. https://xxxxx.supabase.co).
# In Supabase Dashboard -> Authentication -> URL Configuration:
#   - Site URL should match PUBLIC_APP_URL (e.g. https://voxdex.com)
#   - Add all auth redirect URLs your environment uses.
SUPABASE_URL=

# REQUIRED on the client (shipped to browser). The anon/publishable key.
SUPABASE_ANON_KEY=

# REQUIRED on the server. Service-role key — NEVER ship to client.
SUPABASE_SERVICE_ROLE_KEY=


# ─── 4. Email (Resend + auth hook) ──────────────────────────────────────────
# REQUIRED in production. Resend API key — all transactional email
# (verify/welcome/recovery + engagement) goes through server/emails/send.ts.
# Without it the email client throws on first send (dev: use EMAIL_DRY_RUN).
RESEND_API_KEY=

# REQUIRED in production. Shared secret for the Supabase "Send Email" hook
# (server/emails/routes/auth-hook.ts). Generate in Supabase Dashboard ->
# Authentication -> Hooks; format "v1,whsec_...". Auth OTP emails fail
# closed without it.
SEND_EMAIL_HOOK_SECRET=

# Dev convenience: when "true", sendEmail() logs the payload instead of
# calling Resend. Keep "true" locally, never in production.
EMAIL_DRY_RUN=true

# Flip to "true" once the voxdex.com sending domain is verified in Resend.
# Until then all categories send from the Resend sandbox address.
EMAIL_SENDER_DOMAIN_READY=false

# Secret used to sign one-click unsubscribe links in lifecycle emails.
# Keep this distinct from third-party API keys. (Falls back to APP_SECRET /
# SESSION_SECRET when unset — prefer setting it explicitly.)
EMAIL_UNSUBSCRIBE_SECRET=


# ─── 5. External APIs (providers) ───────────────────────────────────────────
# News volume providers. At least one should be set.
# MEDIASTACK — intended primary (Professional plan: 50k calls/mo, uncapped
# paginationTotal). Currently ON STANDBY: as of 2026-05-31 the account's feed
# is frozen (newest article 2026-05-22) and returns paginationTotal:0 for every
# query, so it contributes nothing to the union. Safe to leave keyed — it auto-
# rejoins the union with no code/flip change the moment their ingestion unfreezes.
# Until then, CURRENTS is the live primary (see below).
MEDIASTACK_API_KEY=
SERPER_API_KEY=
SERPAPI_API_KEY=              # SerpApi Google Trends — Production tier ($150/mo, 15k searches)
# Hide the Google Trends UI card once its last real fetch is older than this
# many hours (default 36). Lets the card sunset gracefully if SerpApi billing
# is cancelled, instead of freezing on stale values.
TRENDS_MAX_AGE_HOURS=36

# DataForSEO clickstream search volume — MASS sub-signal (estimated monthly
# searches per person, blended into the wiki/attention mass slot). Uses the
# clickstream bulk endpoint (not Google Ads, which suppresses political names).
# Basic-auth credentials from https://app.dataforseo.com/api-access. ~$0.01-0.03
# per daily batch call for the whole roster. Inert when unset.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
DATAFORSEO_LOCATION_CODE=2840       # DataForSEO location code (2840 = United States)
# Fraction of the wiki/attention mass slot that search volume takes when a
# person has data (0..1). Default 0.30. Set 0 to disable the blend; tune live
# without redeploy. Inert until DATAFORSEO_* credentials are set.
SEARCH_VOLUME_MASS_WEIGHT=0.30
NEWS_API_KEY=                 # legacy NewsAPI, optional
SERP_API_KEY=                 # legacy SerpAPI, optional
YOUTUBE_API_KEY=              # optional, YouTube stats
SPOTIFY_CLIENT_ID=            # optional
SPOTIFY_CLIENT_SECRET=        # optional
X_API_KEY=                    # optional, X/Twitter
X_API_SECRET=                 # optional

# GDELT TLS escape hatch. Set to "true" only when your host can't validate the
# GDELT cert chain. Ignored in production unless GDELT_RELAX_SSL_FORCE=true.
GDELT_RELAX_SSL=false
GDELT_RELAX_SSL_FORCE=false   # emergency-only prod override (DANGEROUS)


# ─── 6. AI / OpenAI ─────────────────────────────────────────────────────────
# The app prefers AI_INTEGRATIONS_OPENAI_API_KEY and falls back to OPENAI_API_KEY.
AI_INTEGRATIONS_OPENAI_API_KEY=
OPENAI_API_KEY=

# xAI / Grok (optional). Used when a scope's provider is set to xai.
# Prefer AI_INTEGRATIONS_XAI_API_KEY; falls back to XAI_API_KEY.
# AI_INTEGRATIONS_XAI_API_KEY=
# XAI_API_KEY=
# XAI_BASE_URL=https://api.x.ai/v1
#
# Agent comments Grok pilot — leave provider unset (openai) until you're ready,
# then set on Railway and redeploy:
#   AGENT_COMMENTS_PROVIDER=xai
#   XAI_API_KEY=...
# Default Grok model when provider=xai is grok-4.5 (flagship voice). Override:
#   AGENT_COMMENTS_MODEL=grok-4.5
#   AGENT_COMMENTS_MODEL=grok-4.3   # cheaper alternative

# Fallback model when a scope has no env override and no cheaper scope default.
# AI_DEFAULT_MODEL=gpt-5.4
#
# Per-scope model routing (server/config/ai-models.ts). Resolution order:
#   env override → provider-aware scope default → AI_DEFAULT_MODEL
# Low-stakes / near-extractive OpenAI scopes default to gpt-5.4-mini in code.
# WHY_TRENDING_MODEL=gpt-5.4-mini
# AGENT_RATIONALE_MODEL=gpt-5.4-mini
# AGENT_COMMENTS_MODEL=gpt-5.4-mini
# MARKET_RESOLVER_MODEL=gpt-5.4-mini
# Keep these on the full model (or leave unset to inherit AI_DEFAULT_MODEL):
# PROFILE_ABOUT_MODEL=
# SHARP_RANKER_MODEL=
# WORLD_MARKETS_MODEL=
# AI_DRAFT_MODEL=
# NATIVE_MARKETS_MODEL=
# RESOLUTION_SCOUT_MODEL=
# MARKET_SCOUT_MODEL=
# VOTE_SCOUT_MODEL=
#
# Profile About web_search: only fire the expensive Responses+web_search pass
# for a missing net-worth figure when the person ranks at or above this cutoff
# (default 50). Top-20 / high-risk / thin-sources / role-change triggers are
# unchanged. Set PROFILE_ABOUT_WEB_SEARCH=off to disable web search entirely.
# PROFILE_NETWORTH_WEBSEARCH_RANK_LIMIT=50
# PROFILE_ABOUT_WEB_SEARCH=auto
#
# Optional flat USD adder per Responses web_search tool call used by
# server/config/ai-cost.ts estimates (default 0.01). Confirm against OpenAI
# billing and update if needed — does not change product behaviour.
# WEB_SEARCH_CALL_COST_USD=0.01


# ─── 7. Ingestion & scoring engine ──────────────────────────────────────────
# How often the in-process ingestion scheduler runs (minutes). Default 60.
INGEST_INTERVAL_MINUTES=60

# Per-source news-refresh cadence for Mediastack (minutes). Default 240 (4h).
# At 159 tracked people, 240min ≈ 29k calls/cycle (~57% of the 50k/month plan),
# with headroom to grow toward ~200 people. Drop to 120 only after upgrading
# to a higher plan tier — the budget hard-stop will throttle automatically if
# projected usage approaches the cycle limit.
MEDIASTACK_REFRESH_INTERVAL_MINUTES=240

# CurrentsAPI (currentsapi.services) — ACTIVE live primary in union mode while
# Mediastack's feed is frozen. Returns fresh, same-day news and covers ~71% of
# the roster well (strong on politics/sport; structural blind spot on creators/
# streamers/crypto — e.g. Clavicular, Kai Cenat, Beyonce, Vitalik return 0, which
# GDELT/Serper backfill in the union). SET CURRENTS_API_KEY to enable it; union
# then runs Currents + GDELT + Serper (+ Mediastack when its feed recovers).
# NOTE: Currents' Cloudflare WAF 403s requests with a default User-Agent — the
# Node provider sends a normal UA so this only bit a local probe script, not prod.
CURRENTS_API_KEY=
CURRENTS_REFRESH_INTERVAL_MINUTES=120

# Scoring engine is a raw mass/velocity composite — no smoothing, no rate
# limiting, no catch-up mode. Legacy variables (SMOOTHING_MODE, EMA_*,
# SPIKE_MIN_DELTA_*, OUTAGE_WEIGHT_REDIST, SMOOTHING_RELAXED_*) are no longer
# read; they can be safely removed from deployment environments.

# News aggregation mode. One of:
#   tiered  — single provider per person (Mediastack → GDELT → Serper fallback)
#   union   — union of all configured providers with URL-level dedup. CURRENT
#             PRODUCTION MODE: Currents (live primary) + GDELT + Serper unioned
#             for coverage. Mediastack is on standby (frozen feed → 0) and auto-
#             rejoins once it recovers; promote it back to anchor then.
#   cascade — Currents primary; DataForSEO → Serper → GDELT only when Currents=0
#             (retired — first-non-zero + DFS depth-50 clip distorted counts)
NEWS_AGGREGATION_MODE=union

# ISO 8601 timestamp marking when you flipped news aggregation mode. Percentile
# stats for `news_count` use snapshots AFTER this cutoff during transitions.
NEWS_AGGREGATION_FLIPPED_AT=

# DataForSEO Google News SERP (cascade fallback tail). Reuses DATAFORSEO_LOGIN/PASSWORD.
# Depth = max news_search items returned per person (~$0.0006 per 10 results billed).
DATAFORSEO_NEWS_DEPTH=50
# Daily live-call cap for the tail (~40 people × 12 cycles/day ≈ 480; default 700).
DATAFORSEO_NEWS_DAILY_CALL_CAP=700

# When "false", trims the verbose per-person diagnostics JSONB written on every
# snapshot. Default "true" — keep verbose during calibration, flip to "false"
# once thresholds are settled.
DIAGNOSTICS_VERBOSE=true

# Rolling window (days) used to compute percentile stats (p25/p50/p75) from
# snapshots. Shorter window = faster calibration to new levels.
ROLLING_WINDOW_DAYS_BASELINE=14   # wiki + search
ROLLING_WINDOW_DAYS_NEWS=7        # news only (reacts faster to aggregation changes)


# ─── 8. Rate limiting ───────────────────────────────────────────────────────
LEADERBOARD_MAX_LIMIT=500
LEADERBOARD_MAX_OFFSET=20000

API_READ_RATE_LIMIT_MAX=600
API_WRITE_RATE_LIMIT_AUTH_MAX=60
API_WRITE_RATE_LIMIT_ANON_MAX=15
API_AUTH_RATE_LIMIT_MAX=10

# Admin bucket — applied to /api/admin/* only. Much higher ceiling than the
# default write bucket. Default 300 / minute.
API_ADMIN_RATE_LIMIT_MAX=300


# ─── 9. Schedulers & cron ───────────────────────────────────────────────────
# Shared secret for /api/cron/* endpoints (Railway/Vercel cron calls).
# REQUIRED when running behind an external cron trigger.
CRON_SECRET=

# Kill-switch — when "true", NO in-process scheduler starts. Use when running
# exclusively via the /api/cron/* endpoints so you don't double-run.
DISABLE_SCHEDULERS=false


# ─── 10. Retention & cleanup ────────────────────────────────────────────────
# Number of days of `page_views` to retain. Between 7 and 730, default 180.
PAGE_VIEW_RETENTION_DAYS=180


# ─── 11. Feature flags & misc ───────────────────────────────────────────────
# Self-trade guard. When "true", blocks a user from trading on a prediction
# market they created (matched on prediction_markets.created_by). Default off
# for pre-launch so founders can seed liquidity on markets they created; flip
# to "true" at public launch to restore the conflict-of-interest block.
# (Accepts the same truthy values as other flags: true/1/yes/on, any case.)
SELF_TRADE_GUARD_ENABLED=false

# When "true" (default after 2026-05-01: false), drops the World Market skip
# rate dramatically and 1.5x's the activity gate. This multiplies the per-sweep
# OpenAI call volume ~3x. Only flip back on once you've validated the per-market
# cache is keeping costs in check.
WORLD_MARKET_BOOST_ENABLED=false

# HARD KILL SWITCH for World Market agent buys (engine + action worker).
# Default: false. When unset/false, agents abstain from World Markets without
# ever touching OpenAI (convergence/sell carve-outs still apply). Native
# markets (Jackpot/H2H/UpDown/Gainer) are unaffected.
#
# Cost-efficient recipe (scouted/anchor still on, no OpenAI assessments):
#   WORLD_MARKETS_LLM_ENABLED=true
#   WORLD_MARKETS_LLM_ASSESSMENTS_ENABLED=false
#
# Full OpenAI path also needs assessments enabled + healthy billing balance.
WORLD_MARKETS_LLM_ENABLED=false

# Soft gate for OpenAI / cached-LLM assessments on unanchored World Markets.
# Default ON when unset. Set to false to keep cash-efficient source-anchor
# betting on scouted markets (and community convergence, if enabled) while
# immediately stopping agent bets that need GPT — including reuse of
# metadata.worldAssessment caches. Requires WORLD_MARKETS_LLM_ENABLED=true
# for any world-market agent path (anchor included).
# WORLD_MARKETS_LLM_ASSESSMENTS_ENABLED=true

# Daily USD spend rail for the World Market LLM engine. Max LLM calls per
# UTC day = floor(daily budget / per-call estimate). Defaults in code:
# $5.00 daily / $0.40 per call.
WORLD_MARKETS_DAILY_BUDGET_USD=5.0
WORLD_MARKETS_PER_CALL_ESTIMATE_USD=0.4

# Native markets (Up/Down, H2H, Gainer) — one LLM assessment per market per 24h
NATIVE_MARKETS_LLM_ENABLED=false
NATIVE_MARKETS_MODEL=
NATIVE_MARKETS_DAILY_BUDGET_USD=2.0
NATIVE_MARKETS_PER_CALL_ESTIMATE_USD=0.012

# ─── Content moderation (P0) ────────────────────────────────────────────────
# Kill switch for OpenAI omni-moderation on user text (comments, Voices, bios,
# usernames, opinion-option suggestions). Defaults ON in production; set to
# false/0/no/off to disable. In dev, set true/1/yes/on to enable locally.
# Fail-open: API errors never block the write path.
# TEXT_MODERATION_ENABLED=
# Score thresholds (0–1). Defaults are X-like (heated debate allowed):
# auto-hide ≥ 0.92 on threats/hate/sexual/self-harm intent; review ≥ 0.78.
# Plain harassment/insults are not queued.
MODERATION_AUTO_HIDE_THRESHOLD=0.92
MODERATION_REVIEW_THRESHOLD=0.78

# ─── World Market ops alerts + AI resolution scout ──────────────────────────
# Recipients for operational alerts (daily World Market digest, content
# moderation digest, instant "needs resolution" pings, AI scout findings,
# news API outage alerts from ingest). Comma-separated. Leave blank to
# disable email delivery (the jobs still run and log, they just no-op the send).
# These go out via Resend through the shared email pipeline.
OPS_ALERT_EMAILS=
# Optional: mirror ops alerts to a dedicated Discord channel. Off unless set.
# Deliberately separate from DISCORD_WEBHOOK_URL so enabling it is explicit.
MARKET_OPS_DISCORD_WEBHOOK_URL=

# AI resolution scout — once-daily GPT + web-search scan of OPEN World Markets
# that flags markets moving toward resolution (condition met, near-certain, or
# a material development). Alert/propose only — it never settles a market.
# Runs inline with the daily ops digest (~08:00 UTC) and is also exposed at
# POST /api/cron/resolution-scout for manual runs.
# Kill switch (default off — same accepted truthy values as the world engine).
RESOLUTION_SCOUT_LLM_ENABLED=false
# Per-run budget rail. Max LLM calls per run = floor(daily / per-call).
RESOLUTION_SCOUT_DAILY_BUDGET_USD=5.0
RESOLUTION_SCOUT_PER_CALL_ESTIMATE_USD=0.4
# Optional model override for the scout (defaults to AI_DEFAULT_MODEL).
RESOLUTION_SCOUT_MODEL=

# ─── Market Scout (World Market sourcing from Polymarket) ───────────────────
# Daily 07:00 UTC (or admin "Scan now"): pulls Polymarket events from a
# stratified mix (global 24h-volume trending + Movies / Music / Celebrities /
# TV tagged feeds), GPT-curates the best fits with soft category diversity
# (politics/sports caps + fitScore floor), and inserts DRAFT World Markets
# for founder review. Never publishes — every scouted market lands as a draft.
# Kill switch default off; the job no-ops when disabled.
# Also at POST /api/cron/market-scout.
MARKET_SCOUT_ENABLED=false
MARKET_SCOUT_MODEL=
MARKET_SCOUT_DAILY_BUDGET_USD=2.0
MARKET_SCOUT_PER_CALL_ESTIMATE_USD=0.25
MARKET_SCOUT_MAX_DRAFTS_PER_RUN=5
# Source resolution watch cadence (minutes). LLM-free poll of Polymarket for
# upstream resolutions of scouted markets — pre-fills settlement winners (with
# an instant ops email) and refreshes the livePrices convergence anchor. Runs
# regardless of MARKET_SCOUT_ENABLED. Default 30. Also at POST /api/cron/source-watch.
SOURCE_WATCH_INTERVAL_MINUTES=30

# Resolution backstop / data-lags trading window for scouted World Markets.
# Polymarket often sets endDate to the *event start* (album release) while
# resolution data lands later (Hits Daily Double, box office). We push endAt
# to a backstop and keep trading open through the measurement window.
# Buffer days past nominal endDate when rules have no explicit "by <date>".
WORLD_MARKET_RESOLUTION_BACKSTOP_DAYS=45
# Days past event start to keep trading open on data-lags markets (capped by backstop).
WORLD_MARKET_TRADING_EXTENSION_DAYS=7

# ─── Vote Scout / Idea Scout (Matchups, Sentiment, Opinion ideation) ─────────
# Manual-only admin tool (Voting CMS → Idea Scout). No scheduler.
# Modes: evergreen (world knowledge), topical / breaking (web_search).
# Optional model override (defaults to AI_DEFAULT_MODEL).
VOTE_SCOUT_MODEL=

# Insights Today's Story — daily GPT headline on /insights (cron-only writer; overview never calls OpenAI).
# Default off for local dev; set true in production (Railway) after deploy.
INSIGHTS_AI_STORY_ENABLED=false
# Max OpenAI attempts per UTC day (default 4). 10-min cooldown after each failure via api_cache.
INSIGHTS_AI_STORY_MAX_PER_DAY=4
# Optional model override (defaults to getAiModel("whyTrending")).
INSIGHTS_AI_STORY_MODEL=

# Optional Discord webhook for critical alerts (ingest failures, etc.).
DISCORD_WEBHOOK_URL=

# Google Analytics 4 (frontend). Set to enable GA page-view tracking in the SPA.
# Example: G-XXXXXXXXXX
VITE_GA_MEASUREMENT_ID=

# Structured logging / observability (all optional).
LOG_LEVEL=info                # one of: trace | debug | info | warn | error | fatal
LOG_PRETTY=false              # "true" for human-friendly dev output
SENTRY_DSN=                   # when set, server-side errors are reported to Sentry


# ─── 12. Optional tuning knobs (all have sensible code defaults) ────────────
# Everything below is OPTIONAL. Leave unset unless you are deliberately
# tuning behaviour — each variable has a default baked into the code and is
# documented at its point of use. Listed here so deployments know they exist.
#
# AI model routing (server/config/ai-models.ts + server/config/ai-client.ts):
#   AI_DEFAULT_MODEL              — fallback model for all AI features
#   OPENAI_BASE_URL               — alternate OpenAI-compatible endpoint
#   XAI_API_KEY / AI_INTEGRATIONS_XAI_API_KEY / XAI_BASE_URL — Grok/xAI
#   AGENT_COMMENTS_PROVIDER       — openai (default) | xai  (Grok pilot)
#   WHY_TRENDING_MODEL, AGENT_RATIONALE_MODEL, AGENT_COMMENTS_MODEL,
#   MARKET_RESOLVER_MODEL         — OpenAI defaults gpt-5.4-mini; comments
#                                   default grok-4.5 when provider=xai
#   PROFILE_ABOUT_MODEL, SHARP_RANKER_MODEL, WORLD_MARKETS_MODEL,
#   AI_DRAFT_MODEL, NATIVE_MARKETS_MODEL, RESOLUTION_SCOUT_MODEL,
#   MARKET_SCOUT_MODEL, VOTE_SCOUT_MODEL — inherit AI_DEFAULT_MODEL unless set
#
# App secrets (fallback chain for signed links/tokens):
#   APP_SECRET / SESSION_SECRET   — fallbacks for EMAIL_UNSUBSCRIBE_SECRET etc.
#
# Graceful shutdown:
#   SHUTDOWN_GRACE_MS             — drain window on SIGTERM (default 10000)
#
# Sentry extras (only read when SENTRY_DSN is set — see server/sentry.ts):
#   SENTRY_ENVIRONMENT, SENTRY_RELEASE, SENTRY_TRACES_SAMPLE_RATE
#
# Agent economy / AMM convergence (server/agents/* — do not touch without
# reading the drain-breaker + convergence docs in code):
#   ARB_COHORT_ENABLED, ARB_AGENT_MAX_STAKE, ARB_CONVERGENCE_MARKETS_PER_SWEEP
#   ARB_MIDWEEK_MIN_EDGE_PP, ARB_MIDWEEK_DECISIVE_PCT
#   COMMUNITY_CONVERGENCE_ENABLED, COMMUNITY_CONVERGENCE_SHADOW
#   COMMUNITY_CONVERGENCE_MARKETS_PER_SWEEP, COMMUNITY_ARB_MIN_EDGE_PP
#   COMMUNITY_SELL_SWEEP_ENABLED
#   MIDWEEK_CONVERGENCE_ENABLED, MIDWEEK_CONVERGENCE_SHADOW
#   LATCH_REVERT_ENABLED, LATCH_REVERT_SHADOW, LATCH_TRAILING_SAMPLE_COUNT
#   DECISIVE_REVERT_PCT
#   LOCKIN_FAIR_ENABLED, LOCKIN_FAIR_SHADOW, LOCKIN_BETA, LOCKIN_SIGMA_1D
#   LOCKIN_FAIR_H2H_ENABLED, LOCKIN_FAIR_H2H_SHADOW, LOCKIN_H2H_BETA,
#   LOCKIN_H2H_SIGMA_1D, LOCKIN_H2H_DECISIVE_FAIR
#   LOCKIN_FAIR_GAINER_ENABLED, LOCKIN_FAIR_GAINER_SHADOW, LOCKIN_GAINER_BETA,
#   LOCKIN_GAINER_SIGMA_1D, LOCKIN_GAINER_DECISIVE_FAIR
#   DRAIN_BREAKER_LOSS_CAP_CREDITS, DRAIN_BREAKER_LOSS_CAP_PCT
#   WARM_START_PRIORS_ENABLED, SHARP_RANKER_LLM_ENABLED
#
# Native market lifecycle (server/native-markets/, server/jobs/):
#   NATIVE_FRIDAY_CUTOFF_ENABLED
#   NATIVE_CLOSE_MEDIAN_HOURS      — trailing-hour median close for up/down/H2H/gainer
#                                   (default 6; set 1 for legacy single-snapshot close)
#   GAINER_CLOSE_MEDIAN_HOURS     — legacy alias for NATIVE_CLOSE_MEDIAN_HOURS
#   H2H_TOP4_PER_CATEGORY_ENABLED, NATIVE_MARKET_MIN_RECENT_INGEST_SAMPLES
#   CLOSE_SNAPSHOT_FALLBACK_MAX_HOURS
#   EARLY_WEEK_SETTLEMENT_BONUS_ENABLED, EARLY_WEEK_SETTLEMENT_BONUS_MULTIPLIER
#   EARLY_WEEK_BONUS_HOURS
#
# Scoring engine tuning (server/scoring/ — read-only area, see .cursorrules):
#   ENGAGEMENT_WEIGHT_DISABLED, ENGAGEMENT_WEIGHT_MAX, ENGAGEMENT_VOLUME_GATE
#   FAME_INDEX_EMA_ALPHA_DOWN, SCORE_EMA_MORE_RAW_ENABLED
#   TRENDS_DAILY_SCALE_CUTOVER, TRENDS_MOMENTUM_DEAD_ZONE_PCT,
#   TRENDS_MOMENTUM_MIN_INTEREST
#   UNION_NEWS_SMOOTHING_ENABLED, UNION_NEWS_SMOOTHING_MODE,
#   UNION_NEWS_SMOOTHING_MEDIASTACK_RATIO
#   SERPER_NEWS_CACHE_TTL_HOURS, WEB_SENTIMENT_MAX_AGE_HOURS
#   DATAFORSEO_LOCATION           — string alias for DATAFORSEO_LOCATION_CODE
#
# Profile generator:
#   PROFILE_ABOUT_WEB_SEARCH      — auto | always | off (web search in "about" gen)
#   PROFILE_NETWORTH_WEBSEARCH_RANK_LIMIT — rank cutoff for missing-net-worth
#                                   web_search trigger (default 50)


# ─── 13. Dev / scripts only (NEVER set in prod) ─────────────────────────────
# Gate behind NODE_ENV !== 'production' checks at the code level.
ALLOW_SEED_DELETE=false
CONFIRM_SEED_DELETE=
DRY_RUN=true
SKIP_VALIDATION=false
VERCEL=                       # set automatically on Vercel; forces serverless mode

# Enables POST /api/admin/native-markets/:id/force-resolve-jackpot, which
# lets the AMM smoke runner (scripts/amm-smoke.ts Phase C) force-close an
# OPEN jackpot market with a synthetic actualScore. Triple-gated — admin
# role + this flag + the market must be marketType='jackpot' AND status=
# 'OPEN'. Leave unset (or "false") in production unless you are actively
# running a jackpot smoke against the deployment; unset it again when done.
SMOKE_FORCE_RESOLVE=false

# Script-only inputs (email previews, model evals):
#   TEST_EMAIL_RECIPIENT, PROFILE_EVAL_MODELS, PROFILE_EVAL_NAMES, USER_ID

# ── Legacy / removed (safe to delete from existing deployments) ─────────────
# The variables below are no longer read by the server. They're kept here as
# a migration aid so anyone still inheriting an old .env can clean them out.
#
#   ENABLE_TEST_ENDPOINTS         — code path deleted in the parimutuel sunset.
#   AMM_NATIVE_FLIP_ENABLED       — non-jackpot markets are always AMM now
#   AMM_GAINER_FLIP_ENABLED         (deleted in commit f80bded1, "parimutuel
#   AMM_COMMUNITY_FLIP_ENABLED      sunset — server + data ops").
#   VITE_USE_MOCK_PREDICT_DATA    — dev-only mock fixtures, removed in b7d171bf.
#   SMOOTHING_MODE, EMA_*,        — pre-Sprint-3 scoring smoothing knobs; see
#   SPIKE_MIN_DELTA_*,              the note at the top of section 6.
#   OUTAGE_WEIGHT_REDIST,
#   SMOOTHING_RELAXED_*
