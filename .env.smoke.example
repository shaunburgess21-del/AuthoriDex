# Copy this file to .env.smoke (gitignored) and fill in the values.
# Used only by `npm run amm:smoke` to drive the Phase 3 smoke test
# against the live Railway deployment.
#
# Tip: SMOKE_BASE_URL can point at any deployment - production, a
# preview, or http://localhost:5000 if you're running the server
# locally. The script never writes to disk.

SMOKE_BASE_URL=https://authoridex-production.up.railway.app

# Alice = the admin who creates the smoke market and runs the resolve.
# Use whichever admin email you log in with on www.voxdex.com.
SMOKE_ALICE_EMAIL=randy.andy@example.com
SMOKE_ALICE_PASSWORD=

# Bob = the second user buying the OTHER side of the market. Either
# admin or non-admin works (the smoke market is draft so Bob also
# needs admin to bypass visibility - see the script comments).
SMOKE_BOB_EMAIL=b2.stealth@example.com
SMOKE_BOB_PASSWORD=

# Optional: override the default smoke market dimensions. Leave blank
# to accept the server defaults (3 outcomes, max-loss = 5000 credits).
# SMOKE_NUM_OUTCOMES=3
# SMOKE_TARGET_MAX_LOSS=5000
