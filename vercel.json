{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build:client",
  "outputDirectory": "dist/public",
  "redirects": [
    {
      "source": "/vote/opinion-polls/the-most-poweful-person-on-earth",
      "destination": "/vote/opinion-polls/the-most-powerful-person-on-earth",
      "permanent": true
    },
    {
      "source": "/polls/perhero-fatigue-is-real",
      "destination": "/polls/superhero-fatigue-is-real",
      "permanent": true
    },
    {
      "source": "/vote/matchups/the-weekend-vs-bruno-mars",
      "destination": "/vote/matchups/the-weeknd-vs-bruno-mars",
      "permanent": true
    },
    {
      "source": "/pricing",
      "destination": "/how-it-works?tab=credits",
      "permanent": false
    },
    {
      "source": "/checkout/:packageId",
      "destination": "/how-it-works?tab=credits",
      "permanent": false
    },
    {
      "source": "/refund-policy",
      "destination": "/terms",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://authoridex-production.up.railway.app/api/$1"
    },
    {
      "source": "/attached_assets/(.*)",
      "destination": "https://authoridex-production.up.railway.app/attached_assets/$1"
    },
    {
      "source": "/sitemap.xml",
      "destination": "https://authoridex-production.up.railway.app/api/sitemap.xml"
    },
    {
      "source": "/robots.txt",
      "destination": "https://authoridex-production.up.railway.app/api/robots.txt"
    },
    {
      "source": "/markets/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(facebookexternalhit|twitterbot|linkedinbot|slackbot|discordbot|whatsapp|telegrambot|skypeuripreview|pinterest|redditbot|embedly|quora link preview|iframely|mastodon|nuzzel|vkshare|tumblr).*"
        }
      ],
      "destination": "https://authoridex-production.up.railway.app/api/og/markets/:slug"
    },
    {
      "source": "/predict/updown/:marketId",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(facebookexternalhit|twitterbot|linkedinbot|slackbot|discordbot|whatsapp|telegrambot|skypeuripreview|pinterest|redditbot|embedly|quora link preview|iframely|mastodon|nuzzel|vkshare|tumblr).*"
        }
      ],
      "destination": "https://authoridex-production.up.railway.app/api/og/predict/updown/:marketId"
    },
    {
      "source": "/predict/h2h/:marketId",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(facebookexternalhit|twitterbot|linkedinbot|slackbot|discordbot|whatsapp|telegrambot|skypeuripreview|pinterest|redditbot|embedly|quora link preview|iframely|mastodon|nuzzel|vkshare|tumblr).*"
        }
      ],
      "destination": "https://authoridex-production.up.railway.app/api/og/predict/h2h/:marketId"
    },
    {
      "source": "/predict/race/:marketId",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(facebookexternalhit|twitterbot|linkedinbot|slackbot|discordbot|whatsapp|telegrambot|skypeuripreview|pinterest|redditbot|embedly|quora link preview|iframely|mastodon|nuzzel|vkshare|tumblr).*"
        }
      ],
      "destination": "https://authoridex-production.up.railway.app/api/og/predict/race/:marketId"
    },
    {
      "source": "/predict",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(facebookexternalhit|twitterbot|linkedinbot|slackbot|discordbot|whatsapp|telegrambot|skypeuripreview|pinterest|redditbot|embedly|quora link preview|iframely|mastodon|nuzzel|vkshare|tumblr).*"
        }
      ],
      "destination": "https://authoridex-production.up.railway.app/api/og/site"
    },
    {
      "source": "/polls/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(facebookexternalhit|twitterbot|linkedinbot|slackbot|discordbot|whatsapp|telegrambot|skypeuripreview|pinterest|redditbot|embedly|quora link preview|iframely|mastodon|nuzzel|vkshare|tumblr).*"
        }
      ],
      "destination": "https://authoridex-production.up.railway.app/api/og/polls/:slug"
    },
    {
      "source": "/vote/opinion-polls/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(facebookexternalhit|twitterbot|linkedinbot|slackbot|discordbot|whatsapp|telegrambot|skypeuripreview|pinterest|redditbot|embedly|quora link preview|iframely|mastodon|nuzzel|vkshare|tumblr).*"
        }
      ],
      "destination": "https://authoridex-production.up.railway.app/api/og/opinion-polls/:slug"
    },
    {
      "source": "/vote/matchups/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(facebookexternalhit|twitterbot|linkedinbot|slackbot|discordbot|whatsapp|telegrambot|skypeuripreview|pinterest|redditbot|embedly|quora link preview|iframely|mastodon|nuzzel|vkshare|tumblr).*"
        }
      ],
      "destination": "https://authoridex-production.up.railway.app/api/og/matchups/:slug"
    },
    {
      "source": "/share/bet/:betId",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(facebookexternalhit|twitterbot|linkedinbot|slackbot|discordbot|whatsapp|telegrambot|skypeuripreview|pinterest|redditbot|embedly|quora link preview|iframely|mastodon|nuzzel|vkshare|tumblr).*"
        }
      ],
      "destination": "https://authoridex-production.up.railway.app/api/og/share/bet/:betId"
    },
    {
      "source": "/person/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(facebookexternalhit|Facebot|twitterbot|linkedinbot|slackbot|discordbot|whatsapp|telegrambot|skypeuripreview|pinterest|redditbot|embedly|quora link preview|iframely|mastodon|nuzzel|vkshare|tumblr|applebot|Googlebot).*"
        }
      ],
      "destination": "https://authoridex-production.up.railway.app/api/og/person/:id"
    },
    {
      "source": "/insights",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(facebookexternalhit|twitterbot|linkedinbot|slackbot|discordbot|whatsapp|telegrambot|skypeuripreview|pinterest|redditbot|embedly|quora link preview|iframely|mastodon|nuzzel|vkshare|tumblr).*"
        }
      ],
      "destination": "https://authoridex-production.up.railway.app/api/og/insights?path=/insights"
    },
    {
      "source": "/explore",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(facebookexternalhit|twitterbot|linkedinbot|slackbot|discordbot|whatsapp|telegrambot|skypeuripreview|pinterest|redditbot|embedly|quora link preview|iframely|mastodon|nuzzel|vkshare|tumblr).*"
        }
      ],
      "destination": "https://authoridex-production.up.railway.app/api/og/insights?path=/explore"
    },
    {
      "source": "/((?!api/|attached_assets/|.*\\.).*)",
      "destination": "/index.html"
    }
  ]
}
